---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubHeader from '../../components/SubHeader.astro';
import { posts, dateLabel } from '../../lib/posts';
import { icon } from '../../lib/icons';
import '../../styles/prose.css';
import { graph, article, breadcrumbs, faqPage, person } from '../../lib/seo';

export function getStaticPaths() {
  return posts.map((p, i) => ({ params: { slug: p.slug }, props: { i } }));
}
const { i } = Astro.props as { i: number };
const post = posts[i];
const next = posts[(i + 1) % posts.length];
const { Content } = post;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? new URL('https://mikolajborawski.pl');
const url = new URL(`${base}/porady/${post.slug}/`, site).href;
const ogPath = `/og/porady/${post.slug}.png`;
const faq = post.faq ?? [];
const ld = graph(
  article(site, { url, title: post.title, description: post.card + ' ' + post.lead, date: post.date, image: new URL(base + ogPath, site).href, lang: 'pl', section: 'Bezpiecznie w sieci' }),
  person(site),
  breadcrumbs(site, [['Mikołaj Borawski', '/'], ['Porady', '/#porady'], [post.title, `/porady/${post.slug}/`]]),
  ...(faq.length ? [faqPage(faq)] : [])
);
---
<BaseLayout title={`${post.title} · Mikołaj Borawski`} description={(post.card + ' ' + post.lead).slice(0, 158)} image={ogPath} type="article" published={post.date} jsonLd={ld}>
  <div class="page">
    <div class="prog" aria-hidden="true"></div>
    <SubHeader back={{ href: '/#porady', label: 'Wszystkie porady' }} />
    <article id="wpis" class="art">
      <div class="art__meta in1">
        <span class="k">{post.num} · {post.tag}</span>
        <span set:html={icon.clock(14) + ` ${post.minutes} min czytania`} />
        <span set:html={icon.calendar(14) + ' ' + dateLabel(post.date)} />
      </div>
      <h1 class="in2">{post.title}</h1>
      <p class="art__lead in3">{post.lead}</p>
      <div class="byline">
        <img src={`${base}/img/avatar-96.webp`} srcset={`${base}/img/avatar-96.webp 1x, ${base}/img/avatar-192.webp 2x`} alt="" width="48" height="48" loading="lazy" decoding="async" />
        <div class="byline__who"><span>Mikołaj Borawski</span><span>uczę się cyberbezpieczeństwa i tłumaczę je po ludzku</span></div>
        <div class="tools noprint">
          <button type="button" class="tb" data-speak aria-pressed="false"><Fragment set:html={icon.volume(16)} /><span>Posłuchaj</span></button>
          <button type="button" class="tb" data-print><Fragment set:html={icon.printer(16)} />Wydrukuj ściągę</button>
          <a class="tb" href={`${base}/porady/losowa/?z=${post.slug}`}><Fragment set:html={icon.dices(16)} />Wylosuj poradę</a>
        </div>
      </div>
      <div class="prose">
        <Content />
      </div>
      {faq.length > 0 && (
        <section class="faq">
          <h2>Najczęstsze pytania</h2>
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}
      <div class="art__end noprint">
        <span>Przyda się komuś z rodziny? Wyślij mu ten wpis.</span>
        <button type="button" class="tb tb--solid" data-share data-url={url} data-title={post.title}><Fragment set:html={icon.share(16)} />Wyślij rodzinie</button>
      </div>
      <div class="art__pick noprint">
        <a class="nextcard" href={`${base}/porady/${next.slug}/`}>
        <small>następna porada · {next.num}</small>
        <strong>{next.title}</strong>
        <span class="mb-time" set:html={icon.clock(13) + `${next.minutes} min`} />
        </a>
        <a class="randcard" href={`${base}/porady/losowa/?z=${post.slug}`}>
          <span class="randcard__ic" set:html={icon.dices(28)} />
          <small>nie wiesz, co dalej?</small>
          <strong>Wylosuj poradę</strong>
        </a>
      </div>
    </article>
    <div class="toast" role="status" hidden data-toast>Link skopiowany, wklej go rodzinie</div>
  </div>
</BaseLayout>
<script>
  import { initPostTools } from '../../scripts/post.js';
  document.addEventListener('astro:page-load', initPostTools);
</script>
