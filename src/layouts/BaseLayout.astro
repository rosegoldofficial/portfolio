---
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import interLatin from '../assets/fonts/inter-tight-latin-wght-normal.woff2?url';
import interLatinExt from '../assets/fonts/inter-tight-latin-ext-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/responsive.css';
import '../styles/blocks.css';

interface Props {
  title: string;
  description: string;
  lang?: 'pl' | 'en';
  mountName?: 'home' | 'en';
  preloadImage?: boolean;
  /** absolute or base-relative ('/og/...') share image */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  /** hreflang pairs, base-relative paths, e.g. { pl: '/', en: '/en/' } */
  alternates?: { pl?: string; en?: string };
  /** JSON-LD string from lib/seo graph() */
  jsonLd?: string;
  published?: string | Date;
  noindex?: boolean;
}
const { title, description, lang = 'pl', mountName, preloadImage, image, type = 'website', alternates, jsonLd, published, noindex } = Astro.props;
const site = Astro.site ?? new URL('https://mikolajborawski.pl');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const abs = (path: string) => new URL(base + path, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image ? (image.startsWith('http') ? image : abs(image)) : abs('/og.jpg');
// GoatCounter: paste your code (e.g. "mikolajborawski") to turn on cookie-free stats.
const GOATCOUNTER = '';
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#0A0B0D" />
    <meta name="author" content="Mikołaj Borawski" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta property="og:site_name" content="Mikołaj Borawski" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pl_PL'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={new Date(published).toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title="Porady: Bezpiecznie w sieci" href={`${base}/porady/rss.xml`} />
    <link rel="alternate" type="application/rss+xml" title="Security notes (EN)" href={`${base}/en/notes/rss.xml`} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {preloadImage && <link rel="preload" as="image" href={`${base}/img/portret.webp`} imagesrcset={`${base}/img/portret-420.webp 420w, ${base}/img/portret.webp 787w`} imagesizes="(max-width: 900px) 90vw, 420px" fetchpriority="high" />}
    {alternates?.pl && <link rel="alternate" hreflang="pl" href={abs(alternates.pl)} />}
    {alternates?.en && <link rel="alternate" hreflang="en" href={abs(alternates.en)} />}
    {alternates?.pl && <link rel="alternate" hreflang="x-default" href={abs(alternates.pl)} />}
    <script is:inline>
      try { if (localStorage.getItem('mb:light') === '1') document.documentElement.dataset.theme = 'light'; } catch (e) {}
    </script>
    {mountName === 'home' && (
      <script is:inline>
        try {
          var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce && !sessionStorage.getItem('mb:intro')) document.documentElement.classList.add('intro');
        } catch (e) {}
      </script>
    )}
    <ClientRouter />
    {GOATCOUNTER && <script is:inline data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>}
  </head>
  <body>
    {mountName === 'home' && (
      <div class="intro-screen" aria-hidden="true">
        <div class="intro__stage">
          <span class="intro__logo"><span class="intro__txt">borawski</span><span class="intro__cur">_</span></span>
          <span class="intro__bar"></span>
        </div>
      </div>
    )}
    <div data-mount={mountName}>
      <slot />
    </div>
    {mountName === 'home' && (
      <script is:inline>
        (function () {
          var html = document.documentElement;
          if (!html.classList.contains('intro')) return;
          var box = document.querySelector(".intro-screen");
          var logo = box && box.querySelector('.intro__logo');
          var target = document.querySelector('.hdr-logo');
          var finish = function () {
            html.classList.remove('intro');
            if (box) box.remove();
            try { sessionStorage.setItem('mb:intro', '1'); } catch (e) {}
            document.dispatchEvent(new Event('mb:intro-done'));
          };
          if (!box || !logo || !target) return finish();
          var fly = function () {
            var a = logo.getBoundingClientRect();
            var b = target.getBoundingClientRect();
            var s = b.width / a.width;
            box.classList.add('is-leaving');
            logo.style.transition = 'transform .75s cubic-bezier(.7,0,.2,1)';
            logo.style.transform = 'translate(' + (b.left - a.left) + 'px,' + (b.top - a.top) + 'px) scale(' + s + ')';
            setTimeout(function () {
              target.style.visibility = 'visible';
              html.classList.add('intro-reveal');
              setTimeout(function () { html.classList.remove('intro-reveal'); }, 1400);
              html.classList.remove('intro');
              document.dispatchEvent(new Event('mb:intro-done'));
              box.style.transition = 'opacity .25s ease';
              box.style.opacity = '0';
              setTimeout(function () { box.remove(); }, 260);
              try { sessionStorage.setItem('mb:intro', '1'); } catch (e) {}
            }, 760);
          };
          var ready = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
          var minTime = new Promise(function (r) { setTimeout(r, 1150); });
          var cap = new Promise(function (r) { setTimeout(r, 2500); });
          Promise.race([Promise.all([ready, minTime]), cap]).then(fly);
          setTimeout(function () { if (html.classList.contains('intro')) finish(); }, 4500);
        })();
      </script>
    )}
    <script>
      import { mount } from '../scripts/bind.js';
      import { initUI } from '../scripts/ui.js';
      const loaders = {
        home: () => import('../scripts/logic/home.js'),
        en: () => import('../scripts/logic/en.js')
      };
      let unmount = null;
      let unui = null;
      document.addEventListener('astro:page-load', async () => {
        unmount?.(); unmount = null;
        unui?.(); unui = initUI();
        const host = document.querySelector('[data-mount]');
        const name = host?.getAttribute('data-mount');
        const root = host?.firstElementChild;
        if (!name || !root || !loaders[name]) return;
        const mod = await loaders[name]();
        unmount = mount(root, mod.default, {});
      });
      document.addEventListener('astro:before-swap', () => { unmount?.(); unmount = null; unui?.(); unui = null; });
    </script>
  </body>
</html>
