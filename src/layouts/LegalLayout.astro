---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; updated: string; }
const { title, description, updated } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`${title} · Mikołaj Borawski`} description={description}>
  <main class="legal">
    <a class="back" href={`${base}/`}>← mikolajborawski.pl</a>
    <h1>{title}</h1>
    <p class="upd">Aktualizacja: {updated}</p>
    <slot />
  </main>
</BaseLayout>
<style>
  .legal { max-width: 720px; margin: 0 auto; padding: 64px 24px 96px; font-size: 17px; line-height: 1.65; color: var(--ink-soft); }
  .legal h1 { font-size: clamp(36px, 6vw, 56px); line-height: 1.05; letter-spacing: -0.03em; color: var(--ink); margin: 24px 0 8px; }
  .legal :global(h2) { font-size: 22px; color: var(--ink); margin: 40px 0 8px; }
  .legal :global(ul) { padding-left: 22px; margin: 8px 0; }
  .legal :global(li) { margin: 4px 0; }
  .legal :global(strong) { color: var(--ink); font-weight: 600; }
  .legal :global(a) { color: var(--accent-text); }
  .back { font-family: var(--font-mono); font-size: 14px; text-decoration: none; }
  .upd { font-family: var(--font-mono); font-size: 13px; color: var(--ink-faint); }
</style>
